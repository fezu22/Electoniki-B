# Required for local development
PORT=3000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=30d
ALLOW_PUBLIC_SHOP_REGISTRATION=false

# Required once on a fresh database so you can create the first shop and owner.
# Use a password of at least 12 characters. Leave all three blank only if an
# existing database already has a Super Admin account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional invoice OCR (Google AI Studio). Without this, invoices can be entered manually.
GEMINI_API_KEY=
# GEMINI_MODEL=your-supported-model-name

# Optional email password-reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=false

# Optional WhatsApp Cloud API automation; configure templates and recipients in Settings.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_INSTALLMENT_TEMPLATE=installment_payment_reminder
WHATSAPP_LOW_STOCK_TEMPLATE=low_stock_alert

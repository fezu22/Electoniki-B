NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=30d
ALLOW_PUBLIC_SHOP_REGISTRATION=false
FRONTEND_DIST_DIR=

# Optional invoice OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional automated WhatsApp reminders and low-stock notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_INSTALLMENT_TEMPLATE=installment_payment_reminder
WHATSAPP_LOW_STOCK_TEMPLATE=low_stock_alert

# Optional: set all three to bootstrap the platform Super Admin once.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Set true only when intentionally promoting an existing shop account.
SUPER_ADMIN_PROMOTE_EXISTING=false
